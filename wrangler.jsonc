// Cloudflare Workers static assets (ADR-0029). The studio site is static: no Worker script, only the
// prerendered files. _headers and _redirects in the output folder still apply.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "digitalpantry",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./artifacts/digital-pantry/dist/public",
    // Unknown paths get our prerendered 404.html with a real 404 status.
    "not_found_handling": "404-page",
    // /pricing serves pricing.html; /pricing.html forwards to /pricing.
    "html_handling": "auto-trailing-slash"
  }
}
